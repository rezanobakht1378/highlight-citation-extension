{
  "manifest_version": 3,
  "name": "Research Highlighter",
  "version": "1.0",
  "description": "Highlight and save scientific content with citation.",
  "permissions": ["activeTab", "scripting", "storage", "downloads"],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.sciencedirect.com/*",
        "*://*.scholar.google.com/*",
        "*://*.springer.com/*",
        "*://*.wiley.com/*",
        "*://*.tandfonline.com/*",
        "*://*.pubmed.ncbi.nlm.nih.gov/*",
        "*://*.researchgate.net/*",
        "*://*.jstor.org/*",
        "*://*.ieeexplore.ieee.org/*",
        "*://*.acs.org/*",
        "*://*.nature.com/*",
        "*://*.plos.org/*",
        "*://*.cambridge.org/*",
        "*://*.oup.com/*",
        "*://*.biorxiv.org/*",
        "*://*.medrxiv.org/*",
        "*://*.cell.com/*",
        "*://*.sciencemag.org/*",
        "*://*.pnas.org/*",
        "*://*.rsc.org/*",
        "*://*.hindawi.com/*",
        "*://*.mdpi.com/*",
        "*://*.frontiersin.org/*",
        "*://*.sagepub.com/*",
        "*://*.arxiv.org/*",
        "*://*.ebscohost.com/*",
        "*://*.ebsco.com/*",
        "*://*.proquest.com/*",
        "*://*.scopus.com/*",
        "*://*.webofknowledge.com/*",
        "*://*.clarivate.com/*",
        "*://*.eric.ed.gov/*",
        "*://*.pubs.acs.org/*",
        "*://*.springernature.com/*",
        "*://*.informa.com/*",
        "*://*.sagepub.co.uk/*",
        "*://*.scitation.org/*",
        "*://*.spiedigitallibrary.org/*",
        "*://*.siam.org/*",
        "*://*.ams.org/*",
        "*://*.aip.org/*",
        "*://*.bioone.org/*",
        "*://*.annualreviews.org/*",
        "*://*.mitpressjournals.org/*",
        "*://*.degruyter.com/*",
        "*://*.brill.com/*",
        "*://*.taylorandfrancis.com/*",
        "*://*.maneyonline.com/*",
        "*://*.karger.com/*",
        "*://*.edpsciences.org/*",
        "*://*.eurekaselect.com/*",
        "*://*.worldscientific.com/*",
        "*://*.scipress.com/*",
        "*://*.bepress.com/*",
        "*://*.ssrn.com/*",
        "*://*.repec.org/*",
        "*://*.ideas.repec.org/*",
        "*://*.econpapers.repec.org/*",
        "*://*.nber.org/*",
        "*://*.projecteuclid.org/*"
      ],
      "js": ["content.js", "popup.js"],
      "css": ["styles.css"]
    }
  ]
}
